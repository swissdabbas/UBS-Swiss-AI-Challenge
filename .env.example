# Copy to .env (never commit). The OpenAI key may alternatively live in api-key.sk.
OPENAI_API_KEY=sk-...
# OPENAI_ORG_ID=org-...          # only if your key belongs to multiple orgs
# OPENAI_PROJECT_ID=proj_...     # only if you use project-scoped keys
OPENAI_MODEL_FAST=gpt-5-mini       # bulk transaction classification
OPENAI_MODEL_REASONING=gpt-5       # ranking and explanations
OPENAI_MAX_SPEND_PER_RUN_CHF=1.00  # hard cap enforced per analysis run

# Local / Swiss-hosted LLM (any OpenAI-compatible endpoint, e.g. Ollama or vLLM)
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=llama3.1:8b
# LOCAL_LLM_API_KEY=not-needed

# Default processing mode shown on the start screen: local | openai | off
# LLM_DEFAULT_MODE=local
